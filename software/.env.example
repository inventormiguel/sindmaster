# Copie para .env.local (local) ou cadastre nas variáveis do projeto (servidor).
# Nenhuma variável é obrigatória para rodar localmente: sem elas, o banco é local
# e os segredos são gerados na primeira execução em .data/segredo-local.

# Endereço público do sistema (links e webhook). Local: http://localhost:3241
APP_URL=

# Banco Postgres (ex.: Neon na região sa-east-1). Vazio = banco local PGlite em .data/pglite
DATABASE_URL=

# Segredo das sessões (obrigatório no servidor publicado). Gere com: openssl rand -hex 32
AUTH_SECRET=

# Chave da cifra dos dados de pagamento dos prestadores. Vazio = derivada do segredo da instalação.
# Defina no servidor publicado e NÃO troque depois (os dados cifrados deixariam de abrir).
CHAVE_CIFRA_DADOS=

# IA (Anthropic). Sem chave, o sistema funciona inteiro sem os recursos de IA.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MODEL_FALLBACK=claude-haiku-4-5-20251001
# Teto mensal de IA por conta, em dólares (padrão 5)
IA_LIMITE_MENSAL_USD=5

# Telegram: token do @BotFather e o @usuario do bot (sem @)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Segredo do header X-Telegram-Bot-Api-Secret-Token (letras, números, _ e -).
# Vazio = derivado do segredo da instalação. Defina quando usar o set-webhook a partir de outra máquina.
TELEGRAM_WEBHOOK_SECRET=

# Rotinas agendadas: Authorization: Bearer <CRON_SECRET>. Vazio = derivado do segredo da instalação.
CRON_SECRET=

# Armazenamento de arquivos na nuvem (store privado). Vazio = pasta local .data/uploads (só desenvolvimento)
BLOB_READ_WRITE_TOKEN=
